# Optional for local HTTPS testing. VIVERSE Worlds deployments automatically
# derive this ID from <appId>-preview.world.viverse.app.
VITE_VIVERSE_CLIENT_ID=your_viverse_app_id

# Public gift-vault service origin. In local development leave this blank to
# use Vite's /api/gifts middleware. A VIVERSE static deployment must point to
# the separately deployed HTTPS gift-vault service so passphrases work across
# accounts and devices.
VITE_GIFT_API_BASE=
GIFT_VAULT_ALLOWED_ORIGIN=
GIFT_VAULT_DIR=

# Browser-to-server endpoint. Local Vite development provides this route and
# calls the official ViveportSoftware/pls-cli binary server-side.
VITE_POLYGON_UPLOAD_ENDPOINT=/api/polygon/upload
VITE_POLYGON_CMS_URL=https://www.viverse.com/polygon-streaming

# pls-cli server options. Authenticate once with tools/bin/pls-cli login.
PLS_CLI_BIN=
PLS_GROUP_ID=
PLS_CLI_STAGE=false
PLS_AI_ENHANCE=true
PLS_COLLIDER=false
PLS_RESOLUTION=high
PLS_COLLIDER_SCALE=2
PLS_SECURE=false
# Optional override. When omitted, the share link falls back to
# https://stream.viverse.com/model/{assetId}.
PLS_PREVIEW_URL_TEMPLATE=
